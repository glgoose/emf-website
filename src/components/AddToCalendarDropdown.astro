---
import type { CollectionEntry } from 'astro:content';
import CalendarAddIcon from './icons/CalendarAddIcon.astro';
import { buildGoogleEventUrl, buildOutlookEventUrl } from '../lib/calendarUrls';

interface Props {
  event: CollectionEntry<'events'>;
  icsHref: string;
  class?: string;
}

const { event, icsHref, class: className } = Astro.props;
const googleUrl = buildGoogleEventUrl(event);
const outlookUrl = buildOutlookEventUrl(event);
---

<details class:list={['group/cal relative inline-block', className]} data-emf-popup-root data-emf-popup-align="right">
  <summary
    class="emf-popup-trigger list-none cursor-pointer"
    aria-label="Voeg toe aan je agenda"
  >
    <CalendarAddIcon />
  </summary>
  <div class="emf-popup">
    <button class="emf-popup-close" type="button" data-emf-popup-close aria-label="Sluiten">×</button>
    <a
      href={icsHref}
      download
      class="emf-popup-item"
    >iCalendar (.ics)</a>
    <a
      href={googleUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="emf-popup-item"
    >google calendar</a>
    <a
      href={outlookUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="emf-popup-item"
    >outlook</a>
  </div>
</details>

<script>
  document.addEventListener('click', event => {
    const closeButton = event.target instanceof Element
      ? event.target.closest('[data-emf-popup-close]')
      : null;

    if (!(closeButton instanceof HTMLElement)) return;
    closeButton.closest('[data-emf-popup-root]')?.removeAttribute('open');
  });
</script>
