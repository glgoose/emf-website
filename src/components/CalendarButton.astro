---
interface Props {
  href: string;
  tooltip: string;
  ariaLabel?: string;
  class?: string;
}

const { href, tooltip, ariaLabel, class: className } = Astro.props;
const tooltipId = `tooltip-${Math.random().toString(36).slice(2, 8)}`;
---

<a
  href={href}
  class:list={['group emf-popup-trigger relative inline-block no-underline hover:no-underline', className]}
  aria-label={ariaLabel}
  aria-describedby={tooltipId}
>
  <slot />
  <span
    id={tooltipId}
    role="tooltip"
    class="emf-popup emf-popup-item pointer-events-none w-max max-w-[17rem] opacity-0 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100 normal-case not-italic tracking-normal"
  >
    {tooltip}
  </span>
</a>
