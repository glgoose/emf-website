---
interface Props {
  title: string;
  sourcePath: string;
}

const { title, sourcePath } = Astro.props;

const previewUrl = new URL(Astro.url.pathname, 'https://concepten.ernestmandelfonds-website.pages.dev').toString();
const sourceUrl = `https://github.com/glgoose/emf-website/blob/main/${sourcePath}`;

const issueTitle = `Feedback: ${title}`;
const issueBody = `Conceptpagina: ${previewUrl}\nBrontekst: ${sourceUrl}`;
const issueUrl = `https://github.com/glgoose/emf-website/issues/new?title=${encodeURIComponent(issueTitle)}&body=${encodeURIComponent(issueBody)}`;
---

<aside class="not-prose mb-5 border border-[#ddd] bg-[#f5f5f5] px-4 py-3 text-[0.9rem] leading-[1.4] text-[#555555]">
  <p class="mb-2 font-bold text-[#111111]">Concept, nog niet gepubliceerd</p>
  <p>
    <a href={sourceUrl} class="underline underline-offset-2 decoration-[0.04em] hover:text-[#111111]">Bekijk brontekst</a>
    {' · '}
    <a href={issueUrl} class="underline underline-offset-2 decoration-[0.04em] hover:text-[#111111]">Geef commentaar</a>
  </p>
</aside>
