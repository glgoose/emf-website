---
// Melding bovenaan een concept (draft: true). Concepten staan unlisted op hun
// definitieve URL; `data-draft` is het merkteken waarop scripts/check-drafts-unlisted.mjs
// de conceptpagina's in dist/ herkent.
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<aside data-draft class="not-prose mb-5 border border-[#ddd] bg-[#f5f5f5] px-4 py-3 text-[0.9rem] leading-[1.4] font-bold text-[#111111]">
  {label}
</aside>
