---
// Taalband onder de byline van een post, variant K1 uit
// ~/.claude/mockups/emf-website/artikelpagina-titel-taal/mockup.html:
// de talen links, de vertaalmelding rechts (onder `lg`: onder elkaar).
// Eén taalversie: geen band. Zie docs/adr/0001-i18n.md #5, #6 en #9.
import { t } from '../i18n/ui';
import { localeMeta } from '../i18n/config';
import type { Locale } from '../i18n/config';
import type { PostVersion } from '../lib/posts';

interface Props {
  currentLocale: Locale;
  versions: PostVersion[];
  notice?: string;
}

const { currentLocale, versions, notice } = Astro.props;
const ui = t(currentLocale);
const current = versions.find(version => version.locale === currentLocale);
const ordered = current ? [current, ...versions.filter(version => version !== current)] : versions;
---

{versions.length > 1 && (
  <div class="k1 not-prose">
    <div class="k1-langs">
      {ordered.map(version => {
        const meta = localeMeta[version.locale];
        const label = version.isOriginal && <i> ({ui.languageOffer.original})</i>;
        return version.locale === currentLocale
          ? <span class="k1-cur" aria-current="true">{meta.nativeName}{label}</span>
          : <a href={version.href} lang={meta.lang} hreflang={meta.lang}>{meta.nativeName}{label}</a>;
      })}
    </div>
    {notice && <span class="k1-note">{notice}</span>}
  </div>
)}

<style>
  .k1,
  .k1-langs {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 1.1rem;
  }
  .k1 {
    font-size: 0.9rem;
    line-height: 1.4;
    color: #555555;
    border-bottom: 1px solid #dddddd;
    padding: 0 0 0.45rem;
    margin: 0 0 2rem;
  }
  .k1-cur {
    color: #111111;
    border-bottom: 1px solid #111111;
  }
  .k1 a {
    color: #555555;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .k1 a:hover {
    color: #111111;
    border-bottom-color: #111111;
  }
  .k1-note {
    font-style: italic;
    font-size: 0.8rem;
    color: #888888;
  }
  /* Onder lg: talen onder elkaar, melding op een eigen regel. */
  .k1-langs {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    flex-basis: 100%;
  }
  .k1-note {
    flex-basis: 100%;
    margin-top: 0.2rem;
  }
  @media (min-width: 1024px) {
    .k1-langs {
      flex-direction: row;
      align-items: baseline;
      gap: 0.2rem 1.1rem;
      flex-basis: auto;
    }
    .k1-note {
      flex-basis: auto;
      margin: 0 0 0 auto;
    }
  }
</style>
