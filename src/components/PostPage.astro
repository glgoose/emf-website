---
// Detailpagina van een post, in elke taal. Gebruikt door src/pages/[slug].astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import SidebarHeading from './SidebarHeading.astro';
import DraftBanner from './DraftBanner.astro';
import LanguageLinks from './LanguageLinks.astro';
import ArticleToc from './ArticleToc.astro';
import { buildToc } from '../lib/toc';
import { render } from 'astro:content';
import { stripHtml } from '../lib/formatDateTime';
import { getVersions, type Post } from '../lib/posts';
import { localeMeta } from '../i18n/config';
import { fill, formatDate, t } from '../i18n/ui';

interface Props {
  item: Post;
}

const { item } = Astro.props;
const { Content, headings } = await render(item);

const { title, subtitle, date, author, summary, source_event, lead_images, lead_credit, context_note, type, draft, lang, translator, translation_of, machine_translated } = item.data;
const ui = t(lang);
const toc = buildToc(headings);
const hasNotes = /^\[\^[^\]]+\]:/m.test(item.body ?? '');
const plainTitle = stripHtml(title);
const pageTitle = author ? `${author}: ${plainTitle}` : plainTitle;
const dateFormatted = formatDate(date, lang);

const siteBase = Astro.site ?? 'https://ernestmandelfonds.org';
const absolute = (path: string) => new URL(path, siteBase).toString();
const ogImage = lead_images?.[0] ? absolute(lead_images[0].src) : undefined;

const versions = await getVersions(item);
const self = versions.find(version => version.post.id === item.id)!;
const original = versions.find(version => version.isOriginal);
const canonicalURL = absolute(self.href);

// Melding rechts in de taalband: alleen op een vertaling.
const noticeTemplates = ui.machineTranslationNotice;
const noticeMain = translation_of && original
  ? ((machine_translated ?? true) ? noticeTemplates.machine : noticeTemplates.human)
  : undefined;
const noticeTranslator = translator
  ? fill((machine_translated ?? true) ? noticeTemplates.reviewedBy : noticeTemplates.translatedBy, { translator })
  : undefined;
const notice = noticeMain && (noticeTranslator ? `${noticeMain}, ${noticeTranslator}` : noticeMain);
const isoDate = date.toISOString();

const alternates = versions.map(version => ({ locale: version.locale, href: version.href }));

const articleStructuredData: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: plainTitle,
  ...(author && { author: { '@type': 'Person', name: author } }),
  datePublished: isoDate,
  dateModified: isoDate,
  ...(summary && { description: summary }),
  url: canonicalURL,
  mainEntityOfPage: canonicalURL,
  inLanguage: localeMeta[lang].contentLanguage,
  publisher: {
    '@type': 'Organization',
    name: 'vzw Ernest Mandelfonds',
  },
  ...(source_event && {
    isBasedOn: absolute(`/activiteiten/${source_event.slug}`),
  }),
  ...(original && !self.isOriginal && {
    translationOfWork: {
      '@type': 'Article',
      url: absolute(original.href),
      inLanguage: localeMeta[original.locale].contentLanguage,
    },
    ...(translator && { translator: { '@type': 'Person', name: translator } }),
  }),
  ...(self.isOriginal && versions.length > 1 && {
    workTranslation: versions
      .filter(version => !version.isOriginal)
      .map(version => ({
        '@type': 'Article',
        url: absolute(version.href),
        inLanguage: localeMeta[version.locale].contentLanguage,
      })),
  }),
};
---

<BaseLayout
  title={pageTitle}
  description={summary}
  ogType="article"
  ogImage={ogImage}
  ogImageAlt={lead_images?.[0]?.alt}
  noindex={draft}
  locale={lang}
  alternates={alternates}
  xDefaultHref={original?.href}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleStructuredData)} />
  </Fragment>
  <Fragment slot="aside">
    <SidebarHeading backHref="/nieuws" backLabel={ui.post.backToNews} title={ui.newsType[type]} as="p">
      {source_event && (
        <p class="-mt-3 mb-[1.4rem] text-[0.8rem] leading-[1.3] italic text-muted [&_a]:underline [&_a]:underline-offset-2 [&_a]:decoration-[0.04em] [&_a:hover]:text-ink">
          {ui.eventPrefix[type]} <a href={`/activiteiten/${source_event.slug}`}><Fragment set:html={source_event.label} /></a>
        </p>
      )}
    </SidebarHeading>
    {toc && <ArticleToc toc={toc} variant="spine" hasNotes={hasNotes} label={ui.post.contents} notesLabel={ui.post.notes} topLabel={ui.post.topLabel} />}
  </Fragment>

  <article class="prose news-article">
    <header class="not-prose">
      <hgroup>
        <h1 class="m-0 text-[1.9rem] leading-[1.05] font-bold tracking-[-0.005em] [text-wrap:balance] lg:text-[2.6rem]" set:html={title} />
        {subtitle && <p class="mt-[0.45rem] mb-0 text-[1.3rem] leading-[1.25] italic text-muted">{subtitle}</p>}
      </hgroup>
      <p class="mt-[0.9rem] mb-5 text-[1rem] text-ink">{author && <>{author}, </>}<span class="whitespace-nowrap">{dateFormatted}</span></p>
      <LanguageLinks currentLocale={lang} versions={versions} notice={notice} />
    </header>
    {toc && <ArticleToc toc={toc} variant="head" hasNotes={hasNotes} label={ui.post.contents} notesLabel={ui.post.notes} topLabel={ui.post.topLabel} />}
    {draft && <DraftBanner label={ui.post.draftNotice} />}
    {lead_images && lead_images.length > 0 && (
      <figure class="lead-images">
        <div class="lead-images-row">
          {lead_images.map((img) => (
            <a href={img.src} data-lightbox aria-label={`${img.alt} (${ui.post.enlargeImage})`}><img src={img.src} alt={img.alt} /></a>
          ))}
        </div>
        {lead_credit && <figcaption class="image-credit" set:html={lead_credit} />}
      </figure>
    )}
    {lead_images && lead_images.length > 0 && (
      <dialog class="lightbox not-prose" aria-label={ui.post.imageEnlarged} tabindex="-1">
        <div class="lightbox-stage">
          <img alt="" />
        </div>
        <button type="button" class="lightbox-btn lightbox-close" data-close aria-label={ui.post.close}>
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
        </button>
        <button type="button" class="lightbox-btn lightbox-zoom-in" data-zoom-in data-label-in={ui.post.zoomIn} data-label-out={ui.post.zoomOut} aria-label={ui.post.zoomIn}>
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5L20 20M7.5 10.5h6" /><path class="zoom-plus" d="M10.5 7.5v6" /></svg>
        </button>
        {lead_images.length > 1 && (
          <>
            <button type="button" class="lightbox-btn lightbox-prev" data-prev aria-label={ui.post.previous}>
              <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M15 4l-8 8 8 8" /></svg>
            </button>
            <button type="button" class="lightbox-btn lightbox-next" data-next aria-label={ui.post.next}>
              <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M9 4l8 8-8 8" /></svg>
            </button>
          </>
        )}
      </dialog>
      <script is:inline src="/js/lightbox.js" defer></script>
    )}
    {context_note && (
      <aside class="aside-note not-prose">
        <span set:html={context_note} />
      </aside>
    )}
    <Content />
  </article>
  <script is:inline src="/js/footnotes.js" defer></script>
  {toc && <script is:inline src="/js/toc.js" defer></script>}
</BaseLayout>
