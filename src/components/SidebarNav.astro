---
import type { NavItem } from '../data/overEmfNav.ts';
import SidebarBackLink from './SidebarBackLink.astro';

interface Props {
  backHref: string;
  sectionLabel: string;
  sectionHref: string;
  currentPage: string;
  navItems: NavItem[];
  sectionClickable?: boolean;
  underlineCurrent?: boolean;
}

const {
  backHref,
  sectionLabel,
  sectionHref,
  currentPage,
  navItems,
  sectionClickable = true,
  underlineCurrent = false,
} = Astro.props;

const navItemBase = 'block text-sm leading-[1.25] lowercase tracking-normal [font-variant-caps:normal]';
---

<>
  <SidebarBackLink href={backHref} variant="mobile" />
  <div class="border-t-[2px] border-[#111111] pt-0.5">
    <div class="mb-4">
      <div class="block lg:inline-block max-w-full overflow-visible align-top group relative">
        <p class="text-[1.25rem] leading-[1.25] font-bold lowercase [hyphens:none] [overflow-wrap:normal] [word-break:normal]">
          <span class="sidebar-back-anchor-group relative inline-block max-w-full">
            <SidebarBackLink href={backHref} variant="desktop" />{sectionClickable
              ? <a href={sectionHref} class="text-[#111111] hover:underline underline-offset-2 decoration-[0.08em]">{sectionLabel}</a>
              : <span class="text-[#111111]">{sectionLabel}</span>
            }
          </span>
        </p>
      </div>
    </div>
    <nav aria-label="Paginanavigatie">
      <ul class="list-none m-0 p-0 space-y-1 text-sm lowercase">
        {navItems.map(item => (
          <li>
            {item.id === currentPage ? (
              <>
                <span
                  aria-current="page"
                  class:list={[
                    navItemBase,
                    'font-bold text-[#111111]',
                    underlineCurrent && 'underline underline-offset-2 decoration-[0.04em]',
                  ]}
                >
                  {item.label}
                </span>
                {item.children && (
                  <ul class="list-none m-0 p-0 mt-1 ml-3 space-y-1">
                    {item.children.map(child => (
                      <li>
                        <a href={child.href} class:list={[navItemBase, 'text-[#555555] hover:underline underline-offset-2']}>{child.label}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </>
            ) : (
              <a href={item.href} class:list={[navItemBase, 'text-[#555555] hover:underline underline-offset-2']}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</>
