---
import CalendarSubscribeIcon from './icons/CalendarSubscribeIcon.astro';
import { buildGoogleSubscribeUrl, buildOutlookSubscribeUrl } from '../lib/calendarUrls';

interface Props {
  webcalHref: string;
  icsHttpsUrl: string;
  class?: string;
}

const { webcalHref, icsHttpsUrl, class: className } = Astro.props;
const googleUrl = buildGoogleSubscribeUrl(icsHttpsUrl);
const outlookUrl = buildOutlookSubscribeUrl(icsHttpsUrl);
---

<details class:list={['group/cal relative inline-block', className]} data-emf-popup-root data-emf-popup-align="right">
  <summary
    class="emf-popup-trigger list-none cursor-pointer"
    aria-label="Abonneer op de agenda"
  >
    <CalendarSubscribeIcon />
  </summary>
  <div class="emf-popup">
    <button class="emf-popup-close" type="button" data-emf-popup-close aria-label="Sluiten">×</button>
    <a
      href={webcalHref}
      class="emf-popup-item"
    >agenda-app (webcal)</a>
    <a
      href={googleUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="emf-popup-item"
    >google calendar</a>
    <a
      href={outlookUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="emf-popup-item"
    >outlook</a>
  </div>
</details>

<script>
  document.addEventListener('click', event => {
    const closeButton = event.target instanceof Element
      ? event.target.closest('[data-emf-popup-close]')
      : null;

    if (!(closeButton instanceof HTMLElement)) return;
    closeButton.closest('[data-emf-popup-root]')?.removeAttribute('open');
  });
</script>
