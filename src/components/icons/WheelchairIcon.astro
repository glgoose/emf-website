---
// ISA wheelchair symbol in a rounded frame, same line style as CalendarAddIcon.
// Currently unused: kept for when an accessibility icon is wanted somewhere.
// Inline next to text, vertical-align: -0.05em centres it on EB Garamond.
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <rect x="3" y="3" width="18" height="18" rx="2"/>
  <circle cx="11" cy="6.4" r="1.2"/>
  <path d="M11 8.8v4.2h4.2l1.8 4.3h1"/>
  <path d="M11 10.3h3.3"/>
  <path d="M7.7 11.6A4.2 4.2 0 1 0 14.9 14.6"/>
</svg>
