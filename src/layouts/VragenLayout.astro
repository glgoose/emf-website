---
import '../styles/global.css';
import { getVragenEvents } from '../lib/vragenEvents';

interface Props {
  title: string;
}

const { title } = Astro.props;
const events = await getVragenEvents();
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link
      rel="preload"
      href="/fonts/eb-garamond-normal-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/eb-garamond-italic-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body data-events={JSON.stringify(events)}>
    <slot />
  </body>
</html>

<style is:global>
  /* The vragen mockups are designed on the browser default root size; the
     site's global.css sets 24px, which scales every rem here by 1.5. */
  html {
    font-size: 16px;
  }
</style>
