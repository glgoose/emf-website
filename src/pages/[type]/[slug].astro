---
// Posts in de standaardtaal (nl): /<type>/<slug>. Andere talen:
// src/pages/[locale]/[type]/[slug].astro. Zie docs/adr/0001-i18n.md.
import PostPage from '../../components/PostPage.astro';
import { defaultLocale } from '../../i18n/config';
import { typeSlugFor } from '../../lib/newsTypes';
import { getPostsInLocale } from '../../lib/posts';
import { slugFromId } from '../../lib/postRoutes';

export async function getStaticPaths() {
  const items = await getPostsInLocale(defaultLocale);
  return items.map(item => ({
    params: { type: typeSlugFor(item.data.type, defaultLocale), slug: slugFromId(item.id) },
    props: { item },
  }));
}

const { item } = Astro.props;
---

<PostPage item={item} />
