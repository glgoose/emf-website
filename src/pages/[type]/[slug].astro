---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SidebarHeading from '../../components/SidebarHeading.astro';
import { render } from 'astro:content';
import { stripHtml } from '../../lib/formatDateTime';
import { newsTypeLabel } from '../../lib/newsTypes';
import { getPosts } from '../../lib/posts';
import DraftBanner from '../../components/DraftBanner.astro';

export async function getStaticPaths() {
  const items = await getPosts();
  return items.map(item => ({
    params: { type: item.data.type, slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const { title, subtitle, date, author, summary, source_event, type, draft } = item.data;
const plainTitle = stripHtml(title);
const pageTitle = author ? `${author}: ${plainTitle}` : plainTitle;

const dateFormatted = date.toLocaleDateString('nl-BE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const siteBase = Astro.site ?? 'https://ernestmandelfonds.org';
const canonicalURL = new URL(Astro.url.pathname, siteBase).toString();
const isoDate = date.toISOString();

const articleStructuredData: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: plainTitle,
  ...(author && { author: { '@type': 'Person', name: author } }),
  datePublished: isoDate,
  dateModified: isoDate,
  ...(summary && { description: summary }),
  url: canonicalURL,
  mainEntityOfPage: canonicalURL,
  inLanguage: 'nl-BE',
  publisher: {
    '@type': 'Organization',
    name: 'vzw Ernest Mandelfonds',
  },
  ...(source_event && {
    isBasedOn: new URL(`/activiteiten/${source_event.slug}`, siteBase).toString(),
  }),
};
---

<BaseLayout title={pageTitle} description={summary} ogType="article" noindex={draft}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleStructuredData)} />
  </Fragment>
  <Fragment slot="aside">
    <SidebarHeading backHref="/nieuws" title={title} subtitle={subtitle}>
      <div
        class="flex flex-col items-end text-xs leading-snug text-[#555555] max-lg:items-start"
        aria-label="Berichtgegevens"
      >
        {author && <span class="mb-1">{author}</span>}
        <span class="mb-1">{dateFormatted}</span>
        <span class="lowercase">{newsTypeLabel(type)}</span>
      </div>
    </SidebarHeading>
  </Fragment>

  <article class="prose news-article">
    {draft && <DraftBanner title={plainTitle} sourcePath={`src/content/posts/${item.id}.md`} />}
    {source_event && item.data.type !== 'verslag' && (
      <aside class="not-prose mb-5 pt-1 text-[1rem] leading-[1.45] text-[#666666]">
        {source_event.note}{' '}
        <a href={`/activiteiten/${source_event.slug}`} class="underline underline-offset-2 decoration-[0.04em] hover:text-[#111111]">
          <Fragment set:html={source_event.label} />
        </a>.
      </aside>
    )}
    <Content />
  </article>
</BaseLayout>
