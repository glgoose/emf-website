---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventList from '../../components/EventList.astro';
import SidebarBackLink from '../../components/SidebarBackLink.astro';
import SubscribeCalendarDropdown from '../../components/SubscribeCalendarDropdown.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events');
const sorted = allEvents.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const today = new Date();
today.setHours(0, 0, 0, 0);

const upcoming = sorted.filter(e => e.data.date >= today);
const past = sorted.filter(e => e.data.date < today).reverse();

const calendarHost = import.meta.env.DEV
  ? Astro.url.host
  : (Astro.site ?? new URL('https://ernestmandelfonds.org')).host;
const calendarHref = `webcal://${calendarHost}/activiteiten/kalender.ics`;
const icsHttpsUrl = `https://${import.meta.env.DEV ? calendarHost : 'ernestmandelfonds.org'}/activiteiten/kalender.ics`;
---

<BaseLayout title="Activiteiten" description="Overzicht van activiteiten en evenementen van Ernest Mandelfonds.">
  <Fragment slot="aside">
    <>
      <SidebarBackLink href="/" variant="mobile" />
      <div class="border-t-[2px] border-[#111111] pt-0.5">
        <div class="flex items-center justify-between lg:block mb-4">
          <h1 class="text-[1.25rem] leading-[1.25] font-bold lowercase [hyphens:none] [overflow-wrap:normal] [word-break:normal]">
            <span class="sidebar-back-anchor-group relative inline-block max-w-full">
              <SidebarBackLink href="/" variant="desktop" /><span>Activiteiten</span>
            </span>
          </h1>
          <SubscribeCalendarDropdown
            webcalHref={calendarHref}
            icsHttpsUrl={icsHttpsUrl}
            class="shrink-0 ml-4 lg:ml-0 lg:mt-2"
          />
        </div>
      </div>
    </>
  </Fragment>

  <div>
    {upcoming.length > 0 ? (
      <section>
        <EventList events={upcoming} />
      </section>
    ) : (
      <p class="text-sm">Er zijn momenteel geen geplande activiteiten.</p>
      )}

    {past.length > 0 && (
      <section class="mt-6 sm:mt-8">
        <h2 class="mb-3">
          Voorbije activiteiten
        </h2>
        <EventList events={past} past/>
      </section>
    )}
  </div>
</BaseLayout>
