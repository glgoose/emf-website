---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import PillButton from '../components/PillButton.astro';
import DraftTag from '../components/DraftTag.astro';
import { getCollection } from 'astro:content';
import symbolImg from '../assets/images/symbolORANGY-RED.png';
import { formatLongDate, formatTimeRange } from '../lib/formatDateTime';
import { newsTypeLabel } from '../lib/newsTypes';
import { postHref } from '../lib/postRoutes';
import { getListedPosts } from '../lib/posts';

const today = new Date();
today.setHours(0, 0, 0, 0);

const allEvents = await getCollection('events');
const upcomingEvents = allEvents
  .filter(e => e.data.date >= today)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const nextEvent = upcomingEvents[0] ?? null;

const allPosts = await getListedPosts();
const latestPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const formatDate = (date: Date) => date.toLocaleDateString('nl-BE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const formatPostMeta = (date: Date, author?: string) =>
  [formatDate(date), author].filter(Boolean).join(' · ');

const nextEventTitle = nextEvent
  ? [nextEvent.data.title, nextEvent.data.subtitle].filter(Boolean).join('<br>')
  : '';
const nextEventDate = nextEvent ? formatLongDate(nextEvent.data.date) : '';
const nextEventTime = nextEvent
  ? formatTimeRange(nextEvent.data.time, nextEvent.data.end_time)
  : '';
const nextEventLocation = (nextEvent?.data.location ?? '').split('\n')[0];
const nextEventMeta = nextEvent
  ? [
      nextEventDate,
      nextEventTime,
      nextEventLocation,
    ].filter(Boolean).join(' · ')
  : '';
const nextEventSpeakers = nextEvent?.data.speakers?.length
  ? nextEvent.data.speakers.map(speaker => speaker.name).join(' · ')
  : '';

const websiteStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Ernest Mandelfonds',
  alternateName: 'EMF',
  url: Astro.site ?? 'https://ernestmandelfonds.org',
};
---

<BaseLayout isHomepage={true}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteStructuredData)} />
  </Fragment>
  <Fragment slot="aside">
    <a href="/" class="flex flex-row items-center gap-4 lg:flex-col lg:items-end hover:no-underline">
      <span class="sr-only">Ernest Mandelfonds – startpagina</span>
      <span class="relative block">
        <Picture
          src={symbolImg}
          alt=""
          formats={['avif', 'webp']}
          widths={[50, 65, 80, 100, 130]}
          sizes="(min-width: 1024px) 80px, (min-width: 640px) 65px, 50px"
          quality={30}
          loading="eager"
          fetchpriority="high"
          class="block max-w-[50px] sm:max-w-[65px] lg:max-w-[80px]"
        />
        <svg viewBox="0 0 471 898.4" aria-hidden="true" class="logo-curve absolute inset-0 h-full w-full overflow-visible">
          <path id="logo-curve-path" d="M4.6,589.4 C2.4,581.8 -5.4,558.8 -8.7,543.3 C-11.9,527.8 -13.7,511.9 -15.0,496.2 C-16.2,480.6 -16.7,464.9 -16.0,449.3 C-15.3,433.7 -13.1,418.1 -10.8,402.7 C-8.6,387.3 -5.9,372.1 -2.7,356.7 C0.6,341.3 4.2,325.9 8.6,310.6 C13.1,295.2 18.5,279.9 23.9,264.6 C29.4,249.4 34.9,234.2 41.2,218.9 C47.5,203.6 53.9,188.1 61.8,172.7 C69.6,157.3 78.9,141.9 88.4,126.5 C98.0,111.2 107.8,95.9 119.1,80.5 C130.3,65.2 142.7,49.8 155.9,34.5 C169.1,19.3 191.2,-3.3 198.3,-10.9" fill="none" />
          <text><textPath href="#logo-curve-path" startOffset="0">ernest mandelfonds</textPath></text>
        </svg>
      </span>
    </a>
  </Fragment>

  {nextEvent && (
    <section class="mb-6">
      <a href={`/activiteiten/${nextEvent.id}`} class="group block no-underline hover:no-underline focus-visible:no-underline">
        <article>
          <p class="mt-0 mb-[0.34rem] kicker-label">volgende activiteit</p>
          <h3 class="mt-0 mb-[0.42rem] text-[length:var(--text-lg)] leading-[1.12] font-normal italic normal-case tracking-normal [font-variant:normal] group-hover:underline underline-offset-2" set:html={nextEventTitle} />
          <div class="text-[0.88rem] leading-[1.26]">
            <p>{nextEventMeta}</p>
            {nextEventSpeakers && (
              <p class="mt-[0.08rem]">{nextEventSpeakers}</p>
            )}
          </div>
        </article>
      </a>
    </section>
  )}

  {latestPosts.length > 0 && (
    <section>
      <h2>
        <a href="/nieuws" class="no-underline hover:no-underline focus-visible:no-underline">Laatste nieuws</a>
      </h2>
      <div class="grid gap-x-8 gap-y-5 sm:grid-cols-2">
        {latestPosts.map(post => (
          <article>
            <a href={postHref(post)} class="block no-underline hover:no-underline group">
              <p class="kicker-label mb-1.5">
                {newsTypeLabel(post.data.type)}
                {post.data.draft && <DraftTag spaced />}
              </p>
              <p class="text-xs text-muted mb-1">{formatPostMeta(post.data.date, post.data.author)}</p>
              <h3 class="m-0 text-[1rem] leading-[1.15] font-bold normal-case [font-variant:normal] [font-kerning:auto] tracking-normal group-hover:underline underline-offset-2">
                <Fragment set:html={post.data.title} />
              </h3>
              <p class="mt-2 text-sm leading-[1.35] text-[#333333]">{post.data.summary}</p>
            </a>
          </article>
        ))}
      </div>
    </section>
  )}

  <div class="flex flex-col items-start sm:flex-row sm:items-center sm:justify-between gap-4 mt-10">
    <PillButton href="/steun-ons" class="shrink-0">Steun ons</PillButton>
    <NewsletterForm />
  </div>
</BaseLayout>
