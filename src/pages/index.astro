---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import PillButton from '../components/PillButton.astro';
import DraftTag from '../components/DraftTag.astro';
import { getCollection } from 'astro:content';
import { formatLongDate, formatTimeRange } from '../lib/formatDateTime';
import { newsTypeLabel } from '../lib/newsTypes';
import { postHref } from '../lib/postRoutes';
import { getListedPosts } from '../lib/posts';

const today = new Date();
today.setHours(0, 0, 0, 0);

const allEvents = await getCollection('events');
const upcomingEvents = allEvents
  .filter(e => e.data.date >= today)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const nextEvent = upcomingEvents[0] ?? null;

const allPosts = await getListedPosts();
const latestPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const formatDate = (date: Date) => date.toLocaleDateString('nl-BE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const formatPostMeta = (date: Date, author?: string) =>
  [formatDate(date), author].filter(Boolean).join(' · ');

const nextEventTitle = nextEvent
  ? [nextEvent.data.title, nextEvent.data.subtitle].filter(Boolean).join('<br>')
  : '';
const nextEventDate = nextEvent ? formatLongDate(nextEvent.data.date) : '';
const nextEventTime = nextEvent
  ? formatTimeRange(nextEvent.data.time, nextEvent.data.end_time)
  : '';
const nextEventLocation = (nextEvent?.data.location ?? '').split('\n')[0];
const nextEventMeta = nextEvent
  ? [
      nextEventDate,
      nextEventTime,
      nextEventLocation,
    ].filter(Boolean).join(' · ')
  : '';
const nextEventSpeakers = nextEvent?.data.speakers?.length
  ? nextEvent.data.speakers.map(speaker => speaker.name).join(' · ')
  : '';

const websiteStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Ernest Mandelfonds',
  alternateName: 'EMF',
  url: Astro.site ?? 'https://ernestmandelfonds.org',
};
---

<BaseLayout isHomepage={true}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteStructuredData)} />
  </Fragment>
  <Fragment slot="aside">
    <a href="/" class="flex flex-row items-center gap-4 lg:flex-col lg:items-end hover:no-underline">
      <span class="sr-only">Ernest Mandelfonds – startpagina</span>
      <svg viewBox="0 0 471 898.4" aria-hidden="true" class="logo-curve block aspect-[471/898.4] w-[50px] overflow-visible sm:w-[65px] lg:w-[80px]">
        <path transform="matrix(1.19812 0 0 1.19812 -121.445 -52.888)" fill="#f0593c" d="M 368.27 526.3 C 369.48 523.19 370.69 520.09 371.91 516.98 C 351.98 507.77 332.05 498.56 312.12 489.36 C 310.6 492.64 309.07 495.93 307.55 499.22 C 318.67 527.01 343.55 526.48 368.27 526.3 M 245.09 731.42 C 285.77 743.86 319.84 729.09 322.45 700.6 C 298.02 710.33 273.38 720.14 245.09 731.42 M 337.38 346.45 C 333.64 351.41 329.9 356.37 326.16 361.33 C 349.84 376.94 373.52 392.54 397.2 408.14 C 399.82 404.71 402.44 401.27 405.06 397.84 C 382.5 380.71 359.94 363.58 337.38 346.45 M 238.65 663.27 C 259.17 644.79 279.68 626.32 303.35 605 C 269.41 598.96 243.99 620.75 238.65 663.27 M 314.41 435.75 C 311.76 438.09 309.11 440.42 306.45 442.75 C 311.16 449.86 314.26 459.88 320.87 463.54 C 340.38 474.34 361.28 482.64 381.64 491.91 C 383.33 488.42 385.03 484.93 386.72 481.44 C 362.62 466.21 338.52 450.98 314.41 435.75 M 314.12 641.13 C 286.48 659.38 259.63 677.09 232.79 694.8 C 283.38 695.82 318.11 669.32 314.12 641.13 M 408.67 454.14 C 410.43 451.6 412.18 449.05 413.94 446.5 C 389.32 430.2 364.7 413.89 336.62 395.29 C 335.45 426.56 370.71 451.5 408.67 454.14 M 414.17 339.33 C 428.2 279.93 396.54 257.11 328.2 279.37 C 336.71 286.3 344.5 296.63 348.58 295.34 C 388.62 282.59 406.41 301.7 414.17 339.33 M 325.07 239.82 C 350.35 233.6 373.06 233.21 387.91 222.2 C 395.49 216.59 393.92 180.63 387.88 177.98 C 369.15 169.76 346.3 170.92 325.07 168.45 Z M 439.02 410.74 C 435.48 440.73 436.17 472.92 427.03 502.03 C 416.95 534.14 420.19 562.92 430.18 593.06 C 451.91 532.59 490.45 473.17 439.02 410.74 M 203.6 559.71 C 136.41 569.13 120.72 558.43 107.06 491.71 C 93.33 424.68 107.71 359.84 126.14 295.94 C 154.32 198.17 206.4 114.45 280.03 43.67 C 227.02 119.52 194.88 203.88 179.67 294.12 C 171.41 343.11 166.25 393.17 165.95 442.79 C 165.64 492.99 182.09 499.84 225.87 474.86 C 233.05 470.76 240.77 467.59 252.37 462 C 262.15 500.49 271.1 535.72 281.04 574.83 C 281.04 534.73 279.57 499.38 281.71 464.26 C 282.65 448.76 291 433.75 295.76 418.44 C 299.97 404.87 304.59 391.35 307.53 377.49 C 308.81 371.49 303.27 362.64 306.02 358.58 C 329.46 323.9 302.92 295.48 297.04 264.02 C 291.14 232.49 291.57 199.41 292.93 167.17 C 293.28 158.84 306.6 145.6 315.53 144.13 C 340 140.09 365.31 140.5 390.28 140.65 C 395.36 140.68 402.95 146.21 405.06 151.08 C 424.28 195.44 449.51 236.27 455.09 287.39 C 460.21 334.3 455.96 384.77 485.8 428.02 C 494.52 440.66 495.66 462.17 492.9 478.35 C 485.55 521.43 472.75 563.56 465.09 606.6 C 461.84 624.85 465.12 644.51 466.98 663.38 C 470.09 694.72 474.93 725.89 478.09 757.23 C 480.07 776.8 471.54 787.94 447.85 786.61 C 443.23 734.19 438.66 682.32 434.09 630.45 C 425.37 714.29 412.41 728.1 360.93 708.32 C 351.53 732.68 344.57 758.48 331.39 780.56 C 326.91 788.05 306.73 786.16 293.72 788.56 C 292.54 785.22 291.37 781.88 290.19 778.53 C 301.07 771.76 311.95 764.98 321.45 759.07 C 289.61 755.98 250.1 763.24 228.23 746.89 C 206.86 730.91 203.49 690.86 192.22 661.38 C 189.11 661.09 186.01 660.8 182.91 660.51 C 180.24 679.4 177.49 698.27 174.93 717.17 C 172.31 736.46 171.98 756.41 166.4 774.78 C 163.91 782.95 150.99 787.94 142.81 794.38 C 140.82 792.11 138.82 789.84 136.83 787.58 C 140.72 749.04 141.5 709.8 149.85 672.24 C 153.86 654.2 169.08 634.85 184.71 624.03 C 210.92 605.89 210.44 585.05 203.6 559.71 " />
        <path id="logo-curve-path" d="M4.6,589.4 C2.4,581.8 -5.4,558.8 -8.7,543.3 C-11.9,527.8 -13.7,511.9 -15.0,496.2 C-16.2,480.6 -16.7,464.9 -16.0,449.3 C-15.3,433.7 -13.1,418.1 -10.8,402.7 C-8.6,387.3 -5.9,372.1 -2.7,356.7 C0.6,341.3 4.2,325.9 8.6,310.6 C13.1,295.2 18.5,279.9 23.9,264.6 C29.4,249.4 34.9,234.2 41.2,218.9 C47.5,203.6 53.9,188.1 61.8,172.7 C69.6,157.3 78.9,141.9 88.4,126.5 C98.0,111.2 107.8,95.9 119.1,80.5 C130.3,65.2 142.7,49.8 155.9,34.5 C169.1,19.3 191.2,-3.3 198.3,-10.9" fill="none" />
        <text><textPath href="#logo-curve-path" startOffset="0">ernest mandelfonds</textPath></text>
      </svg>
    </a>
  </Fragment>

  {nextEvent && (
    <section class="mb-6">
      <a href={`/activiteiten/${nextEvent.id}`} class="group block no-underline hover:no-underline focus-visible:no-underline">
        <article>
          <p class="mt-0 mb-[0.34rem] kicker-label">volgende activiteit</p>
          <h3 class="mt-0 mb-[0.42rem] text-[length:var(--text-lg)] leading-[1.12] font-normal italic normal-case tracking-normal [font-variant:normal] group-hover:underline underline-offset-2" set:html={nextEventTitle} />
          <div class="text-[0.88rem] leading-[1.26]">
            <p>{nextEventMeta}</p>
            {nextEventSpeakers && (
              <p class="mt-[0.08rem]">{nextEventSpeakers}</p>
            )}
          </div>
        </article>
      </a>
    </section>
  )}

  {latestPosts.length > 0 && (
    <section>
      <h2>
        <a href="/nieuws" class="no-underline hover:no-underline focus-visible:no-underline">Laatste nieuws</a>
      </h2>
      <div class="grid gap-x-8 gap-y-5 sm:grid-cols-2">
        {latestPosts.map(post => (
          <article>
            <a href={postHref(post)} class="block no-underline hover:no-underline group">
              <p class="kicker-label mb-1.5">
                {newsTypeLabel(post.data.type)}
                {post.data.draft && <DraftTag spaced />}
              </p>
              <p class="text-xs text-muted mb-1">{formatPostMeta(post.data.date, post.data.author)}</p>
              <h3 class="m-0 text-[1rem] leading-[1.15] font-bold normal-case [font-variant:normal] [font-kerning:auto] tracking-normal group-hover:underline underline-offset-2">
                <Fragment set:html={post.data.title} />
              </h3>
              <p class="mt-2 text-sm leading-[1.35] text-[#333333]">{post.data.summary}</p>
            </a>
          </article>
        ))}
      </div>
    </section>
  )}

  <div class="flex flex-col items-start sm:flex-row sm:items-center sm:justify-between gap-4 mt-10">
    <PillButton href="/steun-ons" class="shrink-0">Steun ons</PillButton>
    <NewsletterForm />
  </div>
</BaseLayout>
