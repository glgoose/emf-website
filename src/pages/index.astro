---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import PillButton from '../components/PillButton.astro';
import { getCollection } from 'astro:content';
import symbolImg from '../assets/images/symbolORANGY-RED.png';
import { formatLongDate, formatTimeRange } from '../lib/formatDateTime';
import { newsItemHref, newsTypeLabel } from '../lib/newsTypes';

const today = new Date();
today.setHours(0, 0, 0, 0);

const allEvents = await getCollection('events');
const upcomingEvents = allEvents
  .filter(e => e.data.date >= today)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const nextEvent = upcomingEvents[0] ?? null;

const allPosts = await getCollection('posts');
const latestPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const formatDate = (date: Date) => date.toLocaleDateString('nl-BE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const formatPostMeta = (date: Date, author?: string) =>
  [formatDate(date), author].filter(Boolean).join(' · ');

const nextEventTitle = nextEvent
  ? [nextEvent.data.title, nextEvent.data.subtitle].filter(Boolean).join(' ')
  : '';
const nextEventDate = nextEvent ? formatLongDate(nextEvent.data.date) : '';
const nextEventTime = nextEvent
  ? formatTimeRange(nextEvent.data.time, nextEvent.data.end_time)
  : '';
const nextEventLocation = nextEvent?.data.location ?? '';
const nextEventMeta = nextEvent
  ? [
      nextEventDate,
      nextEventTime,
      nextEventLocation,
    ].filter(Boolean).join(' · ')
  : '';
const nextEventSpeakers = nextEvent?.data.speakers?.length
  ? nextEvent.data.speakers.map(speaker => speaker.name).join(' · ')
  : '';
---

<BaseLayout isHomepage={true}>
  <Fragment slot="aside">
    <a href="/" class="flex flex-row items-center gap-4 lg:flex-col lg:items-end hover:no-underline">
      <p class="whitespace-nowrap italic text-[1.5rem] leading-[1.25] lg:mt-3 lowercase text-[#f0573e] rotate-[-10deg]">Ernest Mandelfonds</p>
      <span class="sr-only"> – startpagina</span>
      <Picture
        src={symbolImg}
        alt=""
        formats={['avif', 'webp']}
        widths={[50, 65, 80, 100, 130]}
        sizes="(min-width: 1024px) 80px, (min-width: 640px) 65px, 50px"
        quality={30}
        loading="eager"
        fetchpriority="high"
        class="block max-w-[50px] sm:max-w-[65px] lg:max-w-[80px]"
      />
    </a>
  </Fragment>

  {nextEvent && (
    <section class="mb-6">
      <a href={`/activiteiten/${nextEvent.id}`} class="group block no-underline hover:no-underline focus-visible:no-underline">
        <article>
          <p class="mt-0 mb-[0.34rem] text-[0.65rem] leading-none text-[#555555] font-normal lowercase [font-variant:small-caps] [font-variant-caps:small-caps] [font-kerning:normal] tracking-[0.08em]">volgende activiteit</p>
          <h3 class="mt-0 mb-[0.42rem] text-[1.15rem] leading-[1.12] font-normal italic normal-case tracking-normal [font-variant:normal] group-hover:underline underline-offset-2" set:html={nextEventTitle} />
          <div class="text-[0.88rem] leading-[1.26]">
            <p>{nextEventMeta}</p>
            {nextEventSpeakers && (
              <p class="mt-[0.08rem]">{nextEventSpeakers}</p>
            )}
          </div>
        </article>
      </a>
    </section>
  )}

  {latestPosts.length > 0 && (
    <section>
      <h2>
        <a href="/nieuws" class="no-underline hover:no-underline focus-visible:no-underline">Laatste nieuws</a>
      </h2>
      <div class="grid gap-x-8 gap-y-5 sm:grid-cols-2">
        {latestPosts.map(post => (
          <article>
            <a href={newsItemHref(post)} class="block no-underline hover:no-underline group">
              <p class="text-[0.65rem] leading-none text-[#555555] font-normal lowercase [font-variant:small-caps] [font-variant-caps:small-caps] [font-kerning:normal] tracking-[0.08em] mb-1.5">
                {newsTypeLabel(post.data.type)}
              </p>
              <p class="text-xs text-[#555555] mb-1">{formatPostMeta(post.data.date, post.data.author)}</p>
              <p class="m-0 text-[1rem] leading-[1.15] font-bold group-hover:underline underline-offset-2">
                <Fragment set:html={post.data.title} />
              </p>
              <p class="mt-2 text-sm leading-[1.35] text-[#333333]">{post.data.summary}</p>
            </a>
          </article>
        ))}
      </div>
    </section>
  )}

  <div class="flex flex-col items-start sm:flex-row sm:items-center sm:justify-between gap-4 mt-10">
    <PillButton href="/steun-ons" class="shrink-0">Steun ons</PillButton>
    <NewsletterForm />
  </div>
</BaseLayout>
