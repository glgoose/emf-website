---
import { getCollection } from 'astro:content';
import NewsListPage from '../../components/NewsListPage.astro';
import { newsNavItems } from '../../data/newsNav';

const allNews = await getCollection('posts');
---

<NewsListPage
  title="Nieuws"
  description="Nieuws van Ernest Mandelfonds."
  items={allNews}
  navItems={newsNavItems(allNews)}
  currentType="all"
  backHref="/"
  latestLabel=""
/>
