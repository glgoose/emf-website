---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SidebarHeading from '../components/SidebarHeading.astro';
import inleidingCover from '../assets/images/publicaties/inleiding-tot-het-marxisme-frontcover.png';
import ecosocialistischCover from '../assets/images/publicaties/ecosocialistisch-manifest.jpg';

const books = [
  {
    title: 'Inleiding tot het marxisme',
    author: 'Ernest Mandel',
    price: '€15',
    slug: 'inleiding-tot-het-marxisme',
    cover: inleidingCover,
    alt: 'Cover Inleiding tot het marxisme',
  },
  {
    title: 'Manifest voor een ecosocialistische revolutie',
    author: 'Vierde Internationale',
    price: '€5',
    slug: 'ecosocialistisch-manifest',
    cover: ecosocialistischCover,
    alt: 'Cover Manifest voor een ecosocialistische revolutie',
  },
];
---

<BaseLayout title="Publicaties" description="Boeken en publicaties van Ernest Mandelfonds.">
  <Fragment slot="aside">
    <SidebarHeading backHref="/" title="Publicaties" />
  </Fragment>

  <section class="border-t-[2px] border-[#111111] pt-1" aria-labelledby="boeken" data-disable-heading-anchors="true">
    <h2 id="boeken" class="m-0 mb-2 text-[0.65rem] leading-none text-[#555555] font-normal not-italic lowercase [font-variant:small-caps] [font-variant-caps:small-caps] [font-kerning:normal] tracking-[0.08em]">boeken</h2>

    <ul class="grid grid-cols-2 list-none m-0 p-0 gap-x-4 gap-y-10 sm:grid-cols-[repeat(2,minmax(0,7.2rem))] sm:gap-x-[1.4rem]">
      {books.map(book => {
        const popoverId = `order-${book.slug}`;
        return (
          <li>
            <a
              href={`/publicaties/${book.slug}/`}
              class="group block max-w-[7.2rem] text-[#111111] no-underline hover:no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#111111]"
              aria-label={`Bekijk ${book.title}`}
            >
              <Picture
                src={book.cover}
                alt={book.alt}
                formats={['avif', 'webp']}
                widths={[120, 180, 240, 360]}
                sizes="(min-width: 640px) 85px, 93px"
                loading="eager"
                decoding="async"
                class="mb-[0.45rem] aspect-[2/3] w-[min(100%,5.8rem)] object-cover sm:w-[5.3rem]"
              />
              <p class="m-0 text-[0.6rem] leading-tight text-[#111111]">{book.author}</p>
              <h3 class="m-0 mt-[0.15rem] text-[0.6rem] leading-[1.18] font-bold tracking-normal normal-case text-[#111111] [font-variant:normal]">
                {book.title}
              </h3>
            </a>
            <span class="mt-1 flex items-baseline gap-1.5 text-[0.6rem] leading-none text-[#111111]">
              <span>{book.price}</span>
              <button
                type="button"
                class="order-button"
                popovertarget={popoverId}
                aria-label="Bestelinformatie"
              >
                [+]
              </button>
              <span id={popoverId} class="order-popover" popover="auto" role="tooltip">
                Stuur ons een e-mail om te bestellen.
              </span>
            </span>
          </li>
        );
      })}
    </ul>
  </section>
</BaseLayout>

<style>
  .order-button {
    display: inline-block;
    width: 1.35em;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #777777;
    cursor: pointer;
    font: inherit;
    font-weight: 400;
    line-height: 1;
    text-align: left;
    text-decoration: none;
  }

  .order-button:hover,
  .order-button:focus,
  .order-button:focus-visible {
    color: #111111;
  }

  .order-popover {
    width: max-content;
    max-width: 11rem;
    padding: 0.3rem 0.38rem;
    border: 1px solid #dddddd;
    background: #ffffff;
    color: #555555;
    font-family: inherit;
    font-size: 0.55rem;
    line-height: 1.15;
    box-shadow: 0 0.12rem 0.35rem rgb(0 0 0 / 0.08);
  }
</style>
