---
import { Picture, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SidebarHeading from '../../components/SidebarHeading.astro';
import PublicationPurchase from '../../components/PublicationPurchase.astro';

const coverImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/images/{events,publicaties}/*',
  { eager: true },
);

export async function getStaticPaths() {
  const publications = await getCollection('publicaties');
  return publications.map(publication => ({
    params: { slug: publication.id },
    props: { publication },
  }));
}

const { publication } = Astro.props;
const { Content } = await render(publication);
const fullFrontmatter = (publication as any).rendered?.metadata?.frontmatter ?? {};
const publicationData = { ...fullFrontmatter, ...publication.data };
const {
  title,
  author,
  cover,
  publication_date,
  month_label,
  pages,
  edition,
  isbn,
  original_title,
  original_year,
  original_url,
  original_note,
  collaboration,
  formats = [],
  retailer,
  cover_credit,
  table_of_contents = [],
  description,
} = publicationData;

const filename = cover.split('/').pop();
const coverMeta = filename
  ? coverImages[`../../assets/images/events/${filename}`]?.default
    ?? coverImages[`../../assets/images/publicaties/${filename}`]?.default
  : undefined;

function formatPublicationMonth(date?: Date | string): string | undefined {
  if (!date) return undefined;
  const parsed = date instanceof Date ? date : new Date(date);
  if (Number.isNaN(parsed.getTime())) return undefined;

  return parsed.toLocaleDateString('nl-BE', {
    month: 'long',
    year: 'numeric',
  });
}

const publicationMeta = [
  month_label ?? formatPublicationMonth(publication_date),
  pages ? `${pages} p` : undefined,
  edition,
].filter(Boolean).join(' · ');

const siteBase = Astro.site ?? 'https://ernestmandelfonds.org';
const ogImageObj = coverMeta
  ? await getImage({ src: coverMeta, width: 1200, format: 'jpeg', quality: 85 })
  : undefined;
const ogImage = ogImageObj ? new URL(ogImageObj.src, siteBase).toString() : undefined;

const bookStructuredData: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: title,
  author: { '@type': 'Person', name: author },
  ...(isbn && { isbn }),
  ...(description && { description }),
  ...(ogImage && { image: ogImage }),
  publisher: {
    '@type': 'Organization',
    name: 'vzw Ernest Mandelfonds',
  },
};
---

<BaseLayout title={title} description={description ?? `${title} van ${author}`} ogImage={ogImage} ogType="book">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(bookStructuredData)} />
  </Fragment>
  <Fragment slot="aside">
    <SidebarHeading backHref="/publicaties" title="publicatie" />
  </Fragment>

  <div class="publication-page">
    <article
      class="publication-detail"
      data-disable-heading-anchors="true"
      style={coverMeta ? `--cover-ratio: ${coverMeta.height / coverMeta.width};` : undefined}
    >
      <div class="publication-head">
        {coverMeta && (
          <Picture
            src={coverMeta}
            alt={`Cover van ${title}`}
            formats={['avif', 'webp']}
            widths={[280, 420, 640, 900]}
            sizes="(min-width: 1024px) 330px, (min-width: 640px) 42vw, 220px"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="publication-cover"
          />
        )}

        <div class="publication-copy">
          <div>
            <p class="publication-kicker">boek</p>
            <h1>{title}</h1>
            <p class="publication-author">{author}</p>

            <div class="publication-meta">
              {publicationMeta && <p>{publicationMeta}</p>}
              {isbn && <p><span class="small-caps-label">ISBN</span> {isbn}</p>}
              {(original_title || original_year) && (
                <p class="fine">
                  oorspronkelijke uitgave:{' '}
                  {original_url ? (
                    <a href={original_url} target="_blank" rel="noopener noreferrer" class="original-link">
                      {original_title ? <em>{original_title}</em> : original_year}
                      {original_title && original_year && ` (${original_year})`}
                    </a>
                  ) : (
                    <>
                      {original_title ? <em>{original_title}</em> : original_year}
                      {original_title && original_year && ` (${original_year})`}
                    </>
                  )}
                </p>
              )}
              {original_note && <p class="fine original-note">{original_note}</p>}
              {collaboration && (
                <p class="publication-note">
                  uitgegeven in samenwerking met het{' '}
                  <a href={collaboration.url} target="_blank" rel="noopener noreferrer">{collaboration.label}</a>
                </p>
              )}
            </div>
          </div>

          <PublicationPurchase formats={formats} retailer={retailer} />
        </div>
      </div>

      <div class="prose publication-body">
        <Content />
      </div>

      {table_of_contents.length > 0 && (
        <section class="publication-toc">
          <h2>Inhoudsopgave</h2>
          <ul>
            {table_of_contents.map(item => (
              <li>
                <span>{item.title}</span>
                <span class="page">{item.page}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {cover_credit && (
        <p class="publication-credit">
          Omslag ontworpen door{' '}
          {cover_credit.url ? (
            <a href={cover_credit.url} target="_blank" rel="noopener noreferrer">{cover_credit.label}</a>
          ) : (
            <span>{cover_credit.label}</span>
          )}
        </p>
      )}
    </article>
  </div>

</BaseLayout>

<style>
  .publication-page {
    width: 100%;
    max-width: 32.5rem;
  }

  .publication-detail {
    border-top: 2px solid #111111;
    padding-top: 0.45rem;
  }

  .publication-head {
    display: grid;
    grid-template-columns: minmax(9.4rem, calc(15.6rem / var(--cover-ratio, 1.48))) minmax(0, 1fr);
    gap: 1.35rem;
    align-items: start;
  }

  .publication-cover {
    width: 100%;
    height: auto;
    background: #ffffff;
  }

  .publication-copy {
    display: flex;
    flex-direction: column;
  }

  .publication-kicker {
    margin: 0 0 0.45rem;
    color: #555555;
    font-size: 0.65rem;
    font-variant: small-caps;
    font-variant-caps: small-caps;
    font-kerning: normal;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: lowercase;
  }

  .publication-detail h1 {
    max-width: 13em;
    margin: 0;
    font-size: 1rem;
    line-height: 1.02;
  }

  .publication-author {
    margin: 0.35rem 0 0;
    color: #111111;
    line-height: 1.25;
  }

  .publication-meta {
    margin-top: 0.72rem;
    padding-top: 0.45rem;
    border-top: 1px solid #e8e8e8;
    color: #555555;
    line-height: 1.28;
  }

  .publication-meta p {
    margin: 0 0 0.18rem;
  }

  .publication-meta p:nth-child(-n + 2) {
    color: #111111;
  }

  .small-caps-label {
    font-variant: normal;
    font-variant-caps: normal;
    font-kerning: normal;
    letter-spacing: 0.08em;
  }

  .publication-meta .fine {
    color: #666666;
    font-size: 0.86rem;
  }

  .publication-meta .original-link {
    color: inherit;
    text-decoration: none;
  }

  .publication-note {
    color: #666666;
    font-size: 0.86rem;
  }

  .publication-note a {
    text-decoration: underline;
    text-decoration-color: #999999;
    text-decoration-thickness: 0.035em;
    text-underline-offset: 2px;
  }

  .publication-body {
    margin-top: 1.8rem;
  }

  .publication-toc h2 {
    margin: 1.15em 0 0.55em;
    font-size: 1.35rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.2;
  }

  .publication-toc ul {
    max-width: 21rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .publication-toc li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 2.25rem;
    padding: 0.08rem 0;
    border-bottom: 1px solid #eeeeee;
    line-height: 1.45;
  }

  .publication-toc .page {
    color: #777777;
    font-variant-numeric: tabular-nums;
  }

  .publication-credit {
    margin: 1.75rem 0 0;
    color: #777777;
    font-size: 0.68rem;
    line-height: 1.25;
  }

  .publication-credit a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: #bbbbbb;
    text-decoration-thickness: 0.035em;
    text-underline-offset: 2px;
  }

  @media (max-width: 760px) {
    .publication-page {
      width: 100%;
    }

    .publication-detail {
      border-top-width: 1px;
    }

    .publication-head {
      grid-template-columns: 1fr;
      gap: 1.35rem;
    }

    .publication-cover {
      max-width: 220px;
    }

    .publication-copy {
      min-height: auto;
    }

  }

</style>
