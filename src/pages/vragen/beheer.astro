---
import VragenLayout from "../../layouts/VragenLayout.astro";
---

<VragenLayout title="Beheer – vragen – Ernest Mandelfonds">
  <main id="beheer" class="desk">
    <div id="gate" class="gate">
      <form id="gate-form" class="gate-form">
        <label class="gate-label" for="gate-pincode">Pincode</label>
        <input
          class="field"
          type="password"
          id="gate-pincode"
          inputmode="numeric"
          autocomplete="off"
        />
        <button type="submit">openen &gt;&gt;</button>
      </form>
      <p class="gate-fout" id="gate-fout" hidden>Ongeldige pincode.</p>
    </div>

    <div id="paneel" hidden>
      <div class="desk-head">
        <div class="title">beheer <span class="chevron">›</span> vragen</div>
        <a
          href="/vragen/scherm"
          target="_blank"
          rel="noopener"
          class="present"
          aria-label="Zaalscherm openen in een nieuw venster"
          data-tip="Zaalscherm openen in een nieuw venster"
          ><svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M3 4h18"></path><rect x="4" y="4" width="16" height="11"></rect
            ><path d="M12 15v3M8 21l4-3 4 3"></path></svg
          ></a
        >
      </div>

      <div class="filters" id="filters"></div>

      <ul class="rows" id="rows"></ul>
    </div>

    <div class="toast" id="toast" hidden>
      <span id="toast-msg"></span><button id="undo">ongedaan maken</button>
    </div>
  </main>
  <script>
    import "../../scripts/vragen/beheer";
  </script>
</VragenLayout>

<style>
  .desk {
    max-width: 1000px;
    margin: 0 auto;
    padding: 32px 24px 64px;
    font-size: 18px;
  }
  button,
  input {
    font: inherit;
    color: inherit;
  }

  .gate {
    max-width: 320px;
    margin: 80px auto 0;
  }
  .gate-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .gate-label {
    font-variant: small-caps;
    letter-spacing: 0.08em;
    font-size: 0.95rem;
  }
  .field {
    display: block;
    width: 100%;
    border: 0;
    border-bottom: 1px solid #111;
    background: transparent;
    outline: none;
    padding: 0.4em 0;
  }
  .gate-form button {
    align-self: flex-end;
    background: none;
    border: 0;
    cursor: pointer;
    font-size: 1.05rem;
    text-underline-offset: 2px;
  }
  .gate-form button:hover {
    text-decoration: underline;
  }
  .field:focus-visible {
    outline: 1px solid #111;
    outline-offset: 2px;
  }
  .gate-fout {
    color: #111;
    font-weight: 700;
    font-size: 0.9rem;
    margin-top: 10px;
  }

  .desk-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    border-bottom: 1px solid #111;
    padding-bottom: 10px;
  }
  .desk-head .title {
    font-size: 1.6rem;
  }
  .desk-head .chevron {
    color: #999;
    font-weight: 400;
  }
  .desk-head a {
    color: #111;
    font-size: 0.95rem;
  }
  .present {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .present svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .present:hover {
    color: #555;
  }
  .present:hover::after {
    content: attr(data-tip);
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    background: #111;
    color: #fff;
    font-size: 0.8rem;
    padding: 3px 8px;
    border-radius: 3px;
    white-space: nowrap;
    pointer-events: none;
    z-index: 2;
  }
  .filters {
    display: flex;
    gap: 22px;
    margin: 18px 0 10px;
    font-size: 0.95rem;
  }
  :global(.filters button) {
    background: none;
    border: 0;
    padding: 0 0 2px;
    cursor: pointer;
    color: #666;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  :global(.filters svg) {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  :global(.filters button.on) {
    color: #111;
    border-bottom: 1px solid #111;
  }
  .rows {
    list-style: none;
  }
  :global(.rows li) {
    display: grid;
    grid-template-columns: 1fr auto 52px;
    gap: 18px;
    align-items: center;
    padding: 12px 14px;
    border-top: 1px solid #e3e3e3;
  }
  :global(.rows li.is-now) {
    background: #f4f3ef;
    box-shadow: inset 3px 0 0 #111;
  }
  :global(.rows li.is-dim .text) {
    color: #888;
  }
  :global(.rows .text) {
    line-height: 1.3;
  }
  :global(.rows .status) {
    font-variant: small-caps;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    color: #111;
    font-weight: 700;
  }
  :global(.rows .meta) {
    font-size: 0.85rem;
    color: #666;
    margin-top: 2px;
  }
  :global(.btns) {
    display: grid;
    grid-template-columns: repeat(3, 28px);
    gap: 6px;
    justify-items: center;
  }
  :global(.btns button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 8px;
    border: 1px solid #ccc;
    background: #fff;
    cursor: pointer;
    border-radius: 3px;
    position: relative;
  }
  :global(.btns button:hover) {
    border-color: #111;
  }
  :global(.btns button.primary) {
    background: #111;
    border-color: #111;
    color: #fff;
  }
  :global(.btns svg) {
    width: 16px;
    height: 16px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  :global(.btns button.primary svg.play) {
    fill: currentColor;
  }
  :global(.btns button[data-tip]:hover::after) {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 6px);
    right: 0;
    background: #111;
    color: #fff;
    font-size: 0.8rem;
    padding: 3px 8px;
    border-radius: 3px;
    white-space: nowrap;
    pointer-events: none;
    z-index: 2;
  }
  :global(.rows .time) {
    font-size: 0.85rem;
    color: #999;
    text-align: right;
    padding-top: 2px;
  }
  .toast {
    position: fixed;
    left: 50%;
    bottom: 28px;
    transform: translateX(-50%);
    background: #111;
    color: #fff;
    padding: 8px 16px;
    font-size: 0.95rem;
    display: flex;
    gap: 16px;
    align-items: center;
    border-radius: 3px;
  }
  .toast button {
    background: none;
    border: 0;
    color: #fff;
    text-decoration: underline;
    cursor: pointer;
  }
</style>
